# Optional local configuration. Process environment overrides this file.
# Values are literal; matching single/double quotes are removed.
# No variable expansion, escape sequences, or inline comments.
# development or testing; anything else (including production) fails closed.
APP_ENV=development
APP_REPOSITORY=mock
# true sets the Secure flag on the session cookie (use behind HTTPS).
APP_HTTPS=false
# Sessions and mock stores. Default on Windows: C:/ais-runtime (outside OneDrive).
# Must be absolute, writable and outside public/; otherwise requests fail with a 500.
# APP_RUNTIME_PATH=C:/ais-runtime

# Unused until MySQL repositories and the Team 6 schema are approved.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_approved_database
DB_USERNAME=replace_with_least_privilege_user
DB_PASSWORD=replace_with_local_secret
