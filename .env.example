# Optional local configuration. Process environment overrides this file.
# Values are literal; matching single/double quotes are removed.
# No variable expansion, escape sequences, or inline comments.
# development or testing; anything else (including production) fails closed.
APP_ENV=development
APP_REPOSITORY=mock
# Optional per-module overrides (T-60): mock or mysql; they default to APP_REPOSITORY.
# A module on mysql requires APP_REPOSITORY_AUTH=mysql. Phase 7.1: MySQL is TEST-ONLY. It is refused at startup unless
# APP_ENV=testing, DB_DATABASE=ais_test, DB_USERNAME=ais_test_app and a loopback DB_HOST, and faculty stays mock until T-30
# (so set per-module overrides, or APP_REPOSITORY=mysql with APP_REPOSITORY_FACULTY=mock). Never falls back to JSON.
# APP_REPOSITORY_AUTH=mock
# APP_REPOSITORY_STUDENTS=mock
# APP_REPOSITORY_ENROLLMENT=mock
# APP_REPOSITORY_FACULTY=mock
# true sets the Secure flag on the session cookie (use behind HTTPS).
APP_HTTPS=false
# Sessions and mock stores. Default on Windows: C:/ais-runtime (outside OneDrive).
# Must be absolute, writable and outside public/; otherwise requests fail with a 500.
# APP_RUNTIME_PATH=C:/ais-runtime

# Team 3: institutional student-number format (PCRE body, no delimiters/anchors).
# Default when unset (generic DEVELOPMENT placeholder, not the school policy): [A-Z0-9][A-Z0-9-]{2,19}. Values are uppercased; an invalid pattern fails at startup.
# STUDENT_NUMBER_PATTERN=[0-9]{4}-[0-9]{5}

# Team 6 (T-60) MariaDB. The app account only; never root. Every connection forces strict sql_mode and UTC.
# Until a cutover is approved, only the test database `ais_test` is used, and only by tests and tools.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_approved_database
DB_USERNAME=replace_with_least_privilege_user
DB_PASSWORD=replace_with_local_secret
# Read only by the CLI tools in database/ (migrations, import), never by the web app.
# DB_MIGRATION_USERNAME=replace_with_migration_account
# DB_MIGRATION_PASSWORD=replace_with_local_secret
# MySQL tests run only when AIS_MYSQL_TESTS=1, APP_ENV=testing, DB_DATABASE=ais_test and AIS_MYSQL_TEST_TARGET=ais_test.
# AIS_MYSQL_TESTS=1
# AIS_MYSQL_TEST_TARGET=ais_test
